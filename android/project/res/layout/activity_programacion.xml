<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        style="@style/Title"
        android:text="Programación de mantenimientos" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                style="@style/Card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Section"
                    android:text="Días feriados" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Registra los días feriados. Al programar mantenimientos se excluyen, programando solo días laborales (lun-vie)."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/fdFecha"
                    style="@style/Input"
                    android:layout_marginTop="10dp"
                    android:hint="Fecha del feriado"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/fdMotivo"
                    style="@style/Input"
                    android:layout_marginTop="8dp"
                    android:hint="Motivo (ej. Navidad)"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btnAgregarFeriado"
                    style="@style/BtnPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Agregar feriado" />

                <LinearLayout
                    android:id="@+id/fdList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                style="@style/Card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Section"
                    android:text="Programar mantenimientos" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Desde la fecha inicial se reprograman los mantenimientos pendientes de todos los equipos: solo días laborales (lun-vie, sin feriados), con máximo 3 equipos por día y por responsable. Si un equipo no tiene mantenimiento pendiente se crea uno nuevo."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/progFechaInicial"
                    style="@style/Input"
                    android:layout_marginTop="10dp"
                    android:hint="Fecha inicial"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btnProgramar"
                    style="@style/BtnPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Programar mantenimientos" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
