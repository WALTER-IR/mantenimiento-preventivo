<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/bg">

    <TextView
        android:id="@+id/formEquipoTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        style="@style/Title"
        android:text="Nuevo equipo" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Label"
                android:text="USUARIO ASIGNADO *" />

            <Spinner
                android:id="@+id/eqResponsable"
                style="@style/Input"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                style="@style/Label"
                android:text="DNI" />

            <EditText
                android:id="@+id/eqDni"
                style="@style/Input"
                android:layout_marginTop="4dp"
                android:hint="DNI del usuario"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                style="@style/Label"
                android:text="HOSTNAME" />

            <EditText
                android:id="@+id/eqHostname"
                style="@style/Input"
                android:layout_marginTop="4dp"
                android:hint="Hostname"
                android:singleLine="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginRight="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Label"
                        android:text="DIR. IP" />

                    <EditText
                        android:id="@+id/eqIp"
                        style="@style/Input"
                        android:layout_marginTop="4dp"
                        android:hint="192.168.x.x"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Label"
                        android:text="SERIE DE EQUIPO *" />

                    <EditText
                        android:id="@+id/eqSerie"
                        style="@style/Input"
                        android:layout_marginTop="4dp"
                        android:hint="S/N"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                style="@style/Label"
                android:text="UBICACIÓN FISICA" />

            <EditText
                android:id="@+id/eqUbicacion"
                style="@style/Input"
                android:layout_marginTop="4dp"
                android:hint="Ubicación física"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                style="@style/Label"
                android:text="EQUIPO" />

            <EditText
                android:id="@+id/eqEquipo"
                style="@style/Input"
                android:layout_marginTop="4dp"
                android:hint="Ej. Laptop / Desktop / Impresora"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                style="@style/Label"
                android:text="COD. INVENTARIO" />

            <EditText
                android:id="@+id/eqCodInv"
                style="@style/Input"
                android:layout_marginTop="4dp"
                android:hint="Código de inventario"
                android:singleLine="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginRight="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Label"
                        android:text="MARCA" />

                    <EditText
                        android:id="@+id/eqMarca"
                        style="@style/Input"
                        android:layout_marginTop="4dp"
                        android:hint="Marca"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Label"
                        android:text="MODELO" />

                    <EditText
                        android:id="@+id/eqModelo"
                        style="@style/Input"
                        android:layout_marginTop="4dp"
                        android:hint="Modelo"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                style="@style/Label"
                android:text="CONTRATO DE ARRENDAMIENTO" />

            <EditText
                android:id="@+id/eqContrato"
                style="@style/Input"
                android:layout_marginTop="4dp"
                android:hint="Contrato de arrendamiento"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                style="@style/Label"
                android:text="STATUS" />

            <Spinner
                android:id="@+id/eqStatus"
                style="@style/Input"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEliminarEquipo"
                    style="@style/BtnDanger"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginRight="6dp"
                    android:text="Eliminar" />

                <Button
                    android:id="@+id/btnGuardarEquipo"
                    style="@style/BtnPrimary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Guardar equipo" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
