<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="me.app.mantenimiento"
    android:versionCode="26"
    android:versionName="3.11.0">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="35" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode|smallestScreenSize">
        </activity>

        <activity android:name=".EquiposActivity" android:exported="false" />
        <activity android:name=".AlertasActivity" android:exported="false" />
        <activity android:name=".ConfigActivity" android:exported="false" />
        <activity android:name=".MantenimientosActivity" android:exported="false" />
        <activity android:name=".EquipoFormActivity" android:exported="false" />
        <activity android:name=".EquipoDetailActivity" android:exported="false" />
        <activity android:name=".MantenimientoFormActivity" android:exported="false" />
        <activity android:name=".UsuariosActivity" android:exported="false" />
        <activity android:name=".UsuarioFormActivity" android:exported="false" />
        <activity android:name=".CargaMasivaActivity" android:exported="false" />
        <activity android:name=".AuditoriaActivity" android:exported="false" />
    </application>
</manifest>
